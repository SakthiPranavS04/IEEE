        { "name": "Update Contact", "request": { "method": "PUT", "url": { "raw": "http://localhost:5000/api/contact/:id", "host": ["http://localhost:5000"], "path": ["api", "contact", ":id"], "variable": [{"key": "id", "value": "replace_with_id"}] }, "header": [{"key": "Content-Type", "value": "application/json"}], "body": { "mode": "raw", "raw": "{\"status\": \"Reviewed\"}" } } },
